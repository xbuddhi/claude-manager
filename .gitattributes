# Generated by ts-rs with LF endings; keep them so the CI freshness check is line-ending proof.
src/bindings/** text eol=lf
# Frontend sources stay LF on every OS: biome checks formatting (LF) in CI, including on Windows runners
# where core.autocrlf would otherwise check them out as CRLF.
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
