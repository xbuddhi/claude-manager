<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Code-signing entitlements for the macOS bundle (tauri.conf.json bundle.macOS.entitlements). Under the
  hardened runtime macOS refuses Apple events (-1743, no prompt) unless the app has this entitlement:
  sessions and "Terminal here" open Terminal or iTerm through osascript. No App Sandbox keys: the sandbox
  would block reading ~/.claude* and running claude (see README).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
